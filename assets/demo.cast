[1.905613, "o", "\u001b[36m*\u001b[0m  Pick a model\r\n\u001b[36m|\u001b[0m  \u001b[32m>\u001b[0m qwen-qwen3.8-flash-next-iq4_xs (IQ4_XS) \u001b[2m(70B+ IQ4_XS \u00b7 ~89.9 GiB (124.5 GiB VRAM) \u00b7 95 on aa-index)\u001b[0m\r\n\u001b[36m|\u001b[0m  \u001b[2m \u001b[0m \u001b[2mqwen-qwen3.8-27b-q8_0 (Q8_0)\u001b[0m \r\n\u001b[36m|\u001b[0m  \u001b[2m \u001b[0m \u001b[2mdeepseek-ai-deepseek-v4-flash-0731-iq3_xxs (IQ3_XXS)\u001b[0m \r\n\u001b[36m|\u001b[0m  \u001b[2m \u001b[0m \u001b[2mminimaxai-minimax-m2.7-iq4_xs (IQ4_XS)\u001b[0m "]
